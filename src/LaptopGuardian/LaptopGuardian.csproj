<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LaptopGuardian</AssemblyName>
    <RootNamespace>LaptopGuardian</RootNamespace>
    <StartupObject>LaptopGuardian.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\LaptopGuardian.ico')">Assets\LaptopGuardian.ico</ApplicationIcon>
    <AssemblyTitle>LaptopGuardian</AssemblyTitle>
    <Description>Explains crashes, graphics errors, sleep failures, heat and battery wear on Windows laptops.</Description>
    <!-- ThemeMode (the Windows 11 Fluent look) is marked experimental in WPF. -->
    <!-- WFO0003: WPF reads its per-monitor DPI setting from the manifest; the WinForms tray icon follows it. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms is here only for the tray icon; keep its types out of the WPF code's way. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LaptopGuardian.ico" Condition="Exists('Assets\LaptopGuardian.ico')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaptopGuardian.Core\LaptopGuardian.Core.csproj" />
  </ItemGroup>

</Project>
